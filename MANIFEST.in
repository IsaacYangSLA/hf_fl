include README.md
include requirements.txt
recursive-include docs *.md *.json
recursive-include examples *.py *.json
recursive-include hf2l *.py
recursive-include tests *.py *.json *.safetensors *.md
recursive-include scripts *.py
include packages/exchange/pyproject.toml
include packages/exchange/README.md
recursive-include packages/exchange/src *.py
recursive-include packages/exchange/tests *.py
include packages/jobs/pyproject.toml
include packages/jobs/README.md
include packages/jobs/MANIFEST.in
recursive-include packages/jobs/src *.py
recursive-include packages/jobs/src/hf2l_jobs/static *
recursive-include packages/jobs/src/hf2l_jobs/templates *
recursive-include packages/jobs/tests *.py
recursive-include deploy/jobs *.py *.md Dockerfile
global-exclude *.py[cod]
global-exclude __pycache__
