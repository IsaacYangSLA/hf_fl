+func TestHF2LMultipartWriteSequenceSurvivesClockRollback(t *testing.T) {
+	saved := multipartWriteSequence.Load()
+	t.Cleanup(func() { multipartWriteSequence.Store(saved) })
+	const future = int64(4_000_000_000_000_000_000)
+	multipartWriteSequence.Store(future)
+	first := hf2lPart("0001_a.part", "a", 4, 1)
+	second := hf2lPart("0001_b.part", "b", 0, 1)
+	markMultipartWrite(first)
+	markMultipartWrite(second)
+	firstTime, _ := multipartEntryTime(first)
+	secondTime, _ := multipartEntryTime(second)
+	if firstTime != future+1 || secondTime != future+2 {
+		t.Fatalf("write order regressed: %d, %d", firstTime, secondTime)
+	}
