+func TestHF2LMultipartCopyNamesAreImmutable(t *testing.T) {
+	server := &S3ApiServer{option: &S3ApiServerOption{BucketsPath: "/buckets"}}
+	firstDir, first := server.copyPartLocation("bucket", "upload", 1)
+	secondDir, second := server.copyPartLocation("bucket", "upload", 1)
+	if firstDir != secondDir || first == second {
