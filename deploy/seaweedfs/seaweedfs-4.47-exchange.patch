+func TestHF2LBucketHasUserObjects(t *testing.T) {
+	const bucket = "/buckets/test"
+	dir := func(name string) *filer_pb.Entry {
+		return &filer_pb.Entry{Name: name, IsDirectory: true}
+	}
+	file := func(name string) *filer_pb.Entry {
+		return &filer_pb.Entry{Name: name}
+	}
+	marker := dir("folder")
+	marker.Attributes = &filer_pb.FuseAttributes{Mime: s3_constants.FolderMimeType}
+	prefixObject := dir("prefix")
+	prefixObject.Extended = map[string][]byte{s3_constants.SeaweedFSPrefixObject: []byte("true")}
+	promotedFile := dir("promoted")
+	promotedFile.Content = []byte("object data")
+	upload := dir("upload")
+	upload.Extended = map[string][]byte{s3_constants.ExtMultipartObjectKey: []byte("key")}
+	deleteMarker := file("marker")
+	deleteMarker.Extended = map[string][]byte{s3_constants.ExtDeleteMarkerKey: []byte("true")}
+
+	tests := []struct {
+		name    string
+		entries map[string][]*filer_pb.Entry
+		want    bool
+	}{
+		{name: "empty"},
+		{
+			name: "empty implicit prefixes",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:                        {dir("artifacts")},
+				bucket + "/artifacts":         {dir("attempt")},
+				bucket + "/artifacts/attempt": {dir("object.versions")},
+			},
+		},
+		{
+			name: "empty internal directories",
+			entries: map[string][]*filer_pb.Entry{
+				bucket: {dir(s3_constants.MultipartUploadsFolder), dir("object.versions")},
+			},
+		},
+		{name: "ordinary object", entries: map[string][]*filer_pb.Entry{bucket: {file("object")}}, want: true},
+		{name: "file with versions suffix", entries: map[string][]*filer_pb.Entry{bucket: {file("object.versions")}}, want: true},
+		{name: "file named uploads", entries: map[string][]*filer_pb.Entry{bucket: {file(s3_constants.MultipartUploadsFolder)}}, want: true},
+		{name: "explicit directory marker", entries: map[string][]*filer_pb.Entry{bucket: {marker}}, want: true},
+		{name: "zero byte prefix object", entries: map[string][]*filer_pb.Entry{bucket: {prefixObject}}, want: true},
+		{name: "promoted file", entries: map[string][]*filer_pb.Entry{bucket: {promotedFile}}, want: true},
+		{
+			name: "nested object",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:             {dir("prefix")},
+				bucket + "/prefix": {file("object")},
+			},
+			want: true,
+		},
+		{
+			name: "retained version under hidden directories",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:                             {dir("prefix")},
+				bucket + "/prefix":                 {dir("object.versions")},
+				bucket + "/prefix/object.versions": {dir(".nested")},
+				bucket + "/prefix/object.versions/.nested": {file("version")},
+			},
+			want: true,
+		},
+		{
+			name: "retained delete marker",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:                      {dir("object.versions")},
+				bucket + "/object.versions": {deleteMarker},
+			},
+			want: true,
+		},
+		{
+			name: "upload with no parts or metadata",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:               {dir(s3_constants.MultipartUploadsFolder)},
+				bucket + "/.uploads": {dir("upload-id")},
+			},
+			want: true,
+		},
+		{
+			name: "multipart metadata on otherwise empty directory",
+			entries: map[string][]*filer_pb.Entry{
+				bucket:             {dir("prefix")},
+				bucket + "/prefix": {upload},
+			},
+			want: true,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			list := func(path, prefix, start string, inclusive bool, limit uint32) ([]*filer_pb.Entry, bool, error) {
+				if prefix != "" || inclusive || start != "" || limit != 10 {
+					t.Fatalf("unexpected list arguments: %q %q %v %d", prefix, start, inclusive, limit)
+				}
+				return test.entries[path], true, nil
+			}
+			got, err := bucketHasUserObjectsWithList(bucket, list)
+			if err != nil || got != test.want {
+				t.Fatalf("got (%v, %v), want (%v, nil)", got, err, test.want)
+			}
+		})
+	}
+}
