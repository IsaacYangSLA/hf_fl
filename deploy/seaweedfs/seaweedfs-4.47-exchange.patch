+package s3api
+
+import (
+	"fmt"
+	"strconv"
+	"testing"
+
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+)
+
+func hf2lPart(name, etag string, size uint64, timestamp int64) *filer_pb.Entry {
+	return &filer_pb.Entry{
+		Name:       name,
+		Attributes: &filer_pb.FuseAttributes{FileSize: size, Mtime: timestamp / 1e9},
+		Extended: map[string][]byte{
+			multipartWriteTimeKey: []byte(strconv.FormatInt(timestamp, 10)),
+			"Seaweed-X-Amz-ETag":  []byte(etag),
+		},
+	}
+}
+
+func TestHF2LMultipartReplacement(t *testing.T) {
+	const now = int64(1_800_000_000_123_456_789)
+	for _, replacement := range []struct {
+		name, oldTag, newTag string
+		oldSize, newSize     uint64
+	}{
+		{"identical retry", "old", "old", 4, 4},
+		{"same size", "old", "new", 4, 4},
+		{"changed size", "old", "new", 3, 4},
+		{"empty replacement", "old", "empty", 4, 0},
+		{"empty original", "empty", "new", 0, 4},
+	} {
+		t.Run(replacement.name, func(t *testing.T) {
+			old := hf2lPart("0001_z.part", replacement.oldTag, replacement.oldSize, now)
+			latest := hf2lPart("0001_a.part", replacement.newTag, replacement.newSize, now+1)
+			for _, entries := range [][]*filer_pb.Entry{{old, latest}, {latest, old}} {
+				got, err := latestMultipartEntries(entries)
+				if err != nil || len(got) != 1 || got[1] != latest {
+					t.Fatalf("got %#v, %v; want latest entry", got, err)
+				}
+			}
+		})
+	}
+}
+
+func TestHF2LMultipartOrderingTie(t *testing.T) {
+	const now = int64(1_800_000_000_123_456_789)
+	first := hf2lPart("0001_a.part", "same", 4, now)
+	retry := hf2lPart("0001_z.part", "same", 4, now)
+	if _, err := latestMultipartEntries([]*filer_pb.Entry{first, retry}); err != nil {
+		t.Fatal(err)
+	}
+	for _, mismatch := range []*filer_pb.Entry{hf2lPart("0001_b.part", "different", 4, now), hf2lPart("0001_b.part", "same", 3, now)} {
+		if _, err := latestMultipartEntries([]*filer_pb.Entry{first, mismatch}); err == nil {
+			t.Fatal("conflicting same-time entries were accepted")
+		}
+	}
+}
+
+func TestHF2LMultipartManyRetries(t *testing.T) {
+	entries := make([]*filer_pb.Entry, 10002)
+	for i := range entries {
+		entries[i] = hf2lPart(fmt.Sprintf("0001_%06d.part", i), "same", 4, int64(i+1))
+	}
+	latest := hf2lPart("0002_latest.part", "last", 2, 20000)
+	entries = append(entries, latest)
+	got, err := latestMultipartEntries(entries)
+	if err != nil || len(got) != 2 || got[1] != entries[10001] || got[2] != latest {
+		t.Fatalf("latest parts lost beyond physical entry limit: %#v, %v", got, err)
+	}
+}
+
+func TestHF2LMultipartMalformedPartFailsClosed(t *testing.T) {
+	for _, name := range []string{"bad.part", "0000_uuid.part", "10001_uuid.part"} {
+		if _, err := latestMultipartEntries([]*filer_pb.Entry{hf2lPart(name, "tag", 4, 1)}); err == nil {
+			t.Fatalf("accepted invalid part %s", name)
+		}
+	}
+	bad := hf2lPart("0001_uuid.part", "tag", 4, 1)
+	bad.Extended[multipartWriteTimeKey] = []byte("not-a-timestamp")
+	if _, err := latestMultipartEntries([]*filer_pb.Entry{bad}); err == nil {
+		t.Fatal("accepted invalid timestamp")
+	}
+}
+
+func TestHF2LMultipartLatestResolvesOlderAmbiguity(t *testing.T) {
+	first := hf2lPart("0001_a.part", "a", 4, 1)
+	second := hf2lPart("0001_b.part", "b", 4, 1)
+	latest := hf2lPart("0001_z.part", "latest", 4, 2)
+	got, err := latestMultipartEntries([]*filer_pb.Entry{first, second, latest})
+	if err != nil || got[1] != latest {
+		t.Fatalf("definitive later replacement failed: %#v, %v", got, err)
+	}
+}
+
+func TestHF2LMultipartPhysicalPagination(t *testing.T) {
