+func TestHF2LBucketHasUserObjectsPagination(t *testing.T) {
+	const bucket = "/buckets/test"
+	for _, nested := range []bool{false, true} {
+		for _, hasObject := range []bool{false, true} {
+			t.Run(fmt.Sprintf("nested=%v/object=%v", nested, hasObject), func(t *testing.T) {
+				directory := bucket
+				if nested {
+					directory += "/prefix"
+				}
+				entries := make([]*filer_pb.Entry, 11)
+				for i := range entries {
+					entries[i] = &filer_pb.Entry{Name: fmt.Sprintf("prefix%02d", i), IsDirectory: true}
+				}
+				entries[10].IsDirectory = !hasObject
+				pages := 0
+				list := func(path, prefix, start string, inclusive bool, limit uint32) ([]*filer_pb.Entry, bool, error) {
+					if nested && path == bucket {
+						return []*filer_pb.Entry{{Name: "prefix", IsDirectory: true}}, true, nil
+					}
+					if path != directory {
+						return nil, true, nil
+					}
+					pages++
+					if (pages == 1 && limit != 10) || (pages == 2 && limit != 1000) || prefix != "" || inclusive {
+						t.Fatalf("unexpected page arguments: page=%d limit=%d prefix=%q inclusive=%v", pages, limit, prefix, inclusive)
+					}
+					begin := sort.Search(len(entries), func(i int) bool { return entries[i].Name > start })
+					end := begin + int(limit)
+					if end > len(entries) {
+						end = len(entries)
+					}
+					return entries[begin:end], end == len(entries), nil
+				}
+				got, err := bucketHasUserObjectsWithList(bucket, list)
+				if err != nil || got != hasObject || pages != 2 {
+					t.Fatalf("got (%v, %v), pages=%d; want (%v, nil), pages=2", got, err, pages, hasObject)
+				}
+			})
+		}
+	}
+}
