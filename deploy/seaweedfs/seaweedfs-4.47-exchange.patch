+			t.Fatalf("physical marker %q", start)
+		}
+		return []*filer_pb.Entry{hf2lPart("0001_b.part", "new", 4, 2), hf2lPart("0002_a.part", "last", 2, 3)}, true, nil
+	})
+	if err != nil || len(entries) != 3 || calls != 2 {
+		t.Fatalf("pagination failed: %v, %v, %d", entries, err, calls)
+	}
+	got, err := latestMultipartEntries(entries)
+	if err != nil || len(got) != 2 || got[1] != entries[1] {
+		t.Fatalf("boundary retry failed: %v, %v", got, err)
+	}
+}
