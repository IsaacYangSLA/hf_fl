+func TestHF2LBucketHasUserObjectsListErrors(t *testing.T) {
+	const bucket = "/buckets/test"
+	listError := errors.New("filer unavailable")
+	for _, nested := range []bool{false, true} {
+		t.Run(fmt.Sprintf("nested=%v", nested), func(t *testing.T) {
+			list := func(path, _, _ string, _ bool, _ uint32) ([]*filer_pb.Entry, bool, error) {
+				if nested && path == bucket {
+					return []*filer_pb.Entry{{Name: "prefix", IsDirectory: true}}, true, nil
+				}
+				return nil, false, listError
+			}
+			if _, err := bucketHasUserObjectsWithList(bucket, list); !errors.Is(err, listError) {
+				t.Fatalf("listing failure was not preserved: %v", err)
+			}
+		})
+	}
+	for _, entries := range [][]*filer_pb.Entry{nil, {nil}, {{Name: ""}}, {{Name: "."}}, {{Name: ".."}}, {{Name: "invalid/path"}}} {
+		list := func(_, _, _ string, _ bool, _ uint32) ([]*filer_pb.Entry, bool, error) {
+			return entries, false, nil
+		}
+		if _, err := bucketHasUserObjectsWithList(bucket, list); err == nil {
+			t.Fatalf("invalid listing must fail closed: %+v", entries)
+		}
+	}
+	t.Run("non advancing page", func(t *testing.T) {
+		list := func(path, _, _ string, _ bool, _ uint32) ([]*filer_pb.Entry, bool, error) {
+			if path != bucket {
+				return nil, true, nil
+			}
+			return []*filer_pb.Entry{{Name: "prefix", IsDirectory: true}}, false, nil
+		}
+		if _, err := bucketHasUserObjectsWithList(bucket, list); err == nil {
+			t.Fatal("repeated page must fail closed")
+		}
+	})
