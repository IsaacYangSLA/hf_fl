+package s3api
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/seaweedfs/seaweedfs/weed/filer"
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"github.com/seaweedfs/seaweedfs/weed/s3api/s3_constants"
+)
+
+const multipartWriteTimeKey = "Seaweedfs-Multipart-Write-Time-Ns"
+
+// Within one S3 gateway, wall-clock adjustments cannot reorder a later part.
+// This is intentionally not a distributed sequencing protocol.
+var multipartWriteSequence atomic.Int64
+
+func markMultipartWrite(entry *filer_pb.Entry) {
+	timestamp := time.Now().UnixNano()
+	for {
+		previous := multipartWriteSequence.Load()
+		if timestamp <= previous {
+			timestamp = previous + 1
+		}
+		if multipartWriteSequence.CompareAndSwap(previous, timestamp) {
+			break
+		}
+	}
+	if entry.Extended == nil {
+		entry.Extended = make(map[string][]byte)
+	}
+	entry.Extended[multipartWriteTimeKey] = []byte(strconv.FormatInt(timestamp, 10))
+}
+
+// listAllMultipartEntries walks physical entries without exposing retry-file
+// names through S3's part-number pagination. Completion must see the same full
+// set as ListParts, including when retries overflow the old 10001-entry limit.
+func (s3a *S3ApiServer) listAllMultipartEntries(directory string) ([]*filer_pb.Entry, error) {
+	return listAllMultipartEntriesWithList(directory, s3a.list)
+}
+
+func listAllMultipartEntriesWithList(directory string, list func(string, string, string, bool, uint32) ([]*filer_pb.Entry, bool, error)) ([]*filer_pb.Entry, error) {
+	var entries []*filer_pb.Entry
+	start := ""
+	for {
+		page, last, err := list(directory, "", start, false, 1000)
+		if err != nil {
+			return nil, err
+		}
+		if len(page) == 0 && !last {
+			return nil, fmt.Errorf("incomplete empty multipart listing")
+		}
+		previous := start
+		for _, entry := range page {
+			if entry == nil || entry.Name <= previous {
+				return nil, fmt.Errorf("invalid multipart listing entry")
+			}
+			previous = entry.Name
+		}
+		entries = append(entries, page...)
+		if last {
+			return entries, nil
+		}
+		next := page[len(page)-1].Name
+		if next <= start {
+			return nil, fmt.Errorf("multipart listing did not advance")
+		}
+		start = next
+	}
+}
+
+func multipartEntryTime(entry *filer_pb.Entry) (int64, error) {
+	if entry == nil || entry.Attributes == nil {
+		return 0, fmt.Errorf("multipart part missing attributes")
+	}
+	if raw := entry.Extended[multipartWriteTimeKey]; len(raw) != 0 {
+		value, err := strconv.ParseInt(string(raw), 10, 64)
+		if err != nil || value <= 0 {
+			return 0, fmt.Errorf("invalid multipart write timestamp")
+		}
+		return value, nil
+	}
+	// Compatibility with parts created before this patch: retain the provider's
+	// internal chunk timestamps, which are more precise than S3 LastModified.
+	if entry.Attributes == nil {
+		return 0, fmt.Errorf("multipart part missing attributes")
+	}
+	latest := entry.Attributes.Mtime * 1e9
+	for _, chunk := range entry.Chunks {
+		if chunk.ModifiedTsNs > latest {
+			latest = chunk.ModifiedTsNs
+		}
+	}
+	return latest, nil
+}
+
+// latestMultipartEntries is shared by listing and completion. UUID filenames
+// are not chronological. Never infer which conflicting bytes win from their
+// lexical order, and never accept an older ETag after its part was overwritten.
+func latestMultipartEntries(entries []*filer_pb.Entry) (map[int]*filer_pb.Entry, error) {
+	latest := make(map[int]*filer_pb.Entry)
+	times := make(map[int]int64)
+	ambiguous := make(map[int]bool)
+	for _, entry := range entries {
+		if entry == nil {
+			return nil, fmt.Errorf("nil multipart entry")
+		}
+		if entry.IsDirectory || !strings.HasSuffix(entry.Name, multipartExt) {
+			continue
+		}
+		number, err := parsePartNumber(entry.Name)
+		if err != nil || number < 1 || number > s3_constants.MaxS3MultipartParts {
+			return nil, fmt.Errorf("invalid multipart part name %q", entry.Name)
+		}
+		timestamp, err := multipartEntryTime(entry)
+		if err != nil {
+			return nil, err
+		}
+		old := latest[number]
+		if old == nil || timestamp > times[number] {
+			latest[number], times[number] = entry, timestamp
+			ambiguous[number] = false
+		} else if timestamp == times[number] {
+			if filer.FileSize(entry) != filer.FileSize(old) || getEtagFromEntry(entry) != getEtagFromEntry(old) {
+				ambiguous[number] = true
+			}
+			// Same bytes and timestamp: choose a stable metadata entry so both
+			// operations agree; immutable chunks remain owned until completion.
+			if entry.Name > old.Name {
+				latest[number] = entry
+			}
+		}
+	}
+	for number, conflict := range ambiguous {
+		if conflict {
+			return nil, fmt.Errorf("ambiguous multipart overwrite for part %d", number)
+		}
+	}
+	return latest, nil
+}
