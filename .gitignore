# Python environments and caches
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
# The Go manager build orchestrator is source, not a Python build output.
!packages/jobs/internal/build/
!packages/jobs/internal/build/**
dist/
*.egg-info/

# Local credentials and Hugging Face caches
.env
.env.*
!.env.example
.cache/
*.exchange-upload.json

# Datasets and model checkpoints do not belong in the GitHub source repo
*.npz
*.safetensors
*.bin
*.pt
*.pth
# ...except the tiny golden fixtures the checkpoint tests compare against
!tests/goldens/**

# Local POC runs and downloaded Hub snapshots
work/
*_work/
bear/
call_*
tchngyang

# OS/editor files
.DS_Store
*.swp

# Private first-federation service and identity configuration
examples/first_federation/.runtime/
