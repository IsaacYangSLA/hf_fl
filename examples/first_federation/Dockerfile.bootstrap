# One-shot storage bootstrap tooling; this image contains no Exchange server.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY examples/first_federation/requirements-bootstrap.txt /opt/hf2l/requirements-bootstrap.txt
RUN pip install --no-cache-dir -r /opt/hf2l/requirements-bootstrap.txt
USER 10001:10001
CMD ["python", "--version"]
