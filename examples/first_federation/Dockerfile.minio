# Community MinIO is distributed as source. Build only verified upstream input.
FROM golang:1.26.8-bookworm@sha256:dc9ad6c05acc7a88e5b71bde60a5fe3bd4b9f0db209011711b464107438a8107 AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOSUMDB=sum.golang.org GOMAXPROCS=4
ADD --checksum=sha256:71794c2df26aad0cc99e8421c58b7aa2dd55969f979b0e7d1e931042e9fabcd6 \
    https://codeload.github.com/minio/minio/tar.gz/7aac2a2c5b7c882e68c1ce017d8256be2feea27f /tmp/minio-source.tar.gz
WORKDIR /build/source
RUN tar -xzf /tmp/minio-source.tar.gz --strip-components=1 \
    && go mod download \
    && go mod verify
RUN go build -p 4 -trimpath -buildvcs=false \
    -ldflags="-s -w -X github.com/minio/minio/cmd.CommitID=7aac2a2c5b7c882e68c1ce017d8256be2feea27f -X github.com/minio/minio/cmd.ShortCommitID=7aac2a2c5b7c" \
    -o /build/minio .

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="7aac2a2c5b7c882e68c1ce017d8256be2feea27f" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later"
COPY --from=build /build/minio /usr/local/bin/minio
COPY --from=build /build/source/LICENSE /usr/share/licenses/minio/LICENSE
COPY --from=build /build/source/NOTICE /usr/share/licenses/minio/NOTICE
# Keep the complete matching upstream source available with the image.
COPY --from=build /tmp/minio-source.tar.gz /usr/share/minio/source.tar.gz
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN mkdir -p /data && chown 10001:10001 /data
ENV HOME=/tmp MINIO_UPDATE=off
USER 10001:10001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data"]
